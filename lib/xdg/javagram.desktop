[Desktop Entry]
Name=StormGram Desktop
Comment=New era of messaging
TryExec=StormGram
Exec=StormGram -- %U
Icon=org.stormgram.desktop
Terminal=false
StartupWMClass=StormGramDesktop
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;x-scheme-handler/ton;x-scheme-handler/srv;
Keywords=tg;chat;im;messaging;messenger;sms;tdesktop;stormgram;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=StormGram -quit
Name=Quit StormGram
Icon=application-exit
